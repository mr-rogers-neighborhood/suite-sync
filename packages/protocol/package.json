{
  "name": "@suite/sync",
  "version": "0.3.4",
  "description": "The Suite sync protocol: workspace, device and member identity, signed membership, version vectors and wire messages. The root entry is pure TypeScript with no Loro; ./loro is the Loro document and WebSocket client half.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./loro": {
      "types": "./dist/loro/index.d.ts",
      "import": "./dist/loro/index.js",
      "default": "./dist/loro/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "loro-crdt": "^1.16.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
