{
  "name": "@suite/sync",
  "version": "0.6.1",
  "description": "The Suite sync protocol: the MLS group a device belongs to, the frames a blind host stores, and the role records that decide who may write. Pure TypeScript, no document format.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "ts-mls": "1.6.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
