{
  "name": "@suite/sync-server",
  "version": "0.1.0",
  "private": true,
  "description": "The headless Suite sync server. Phase 1 is the CLI shell; the workspace server lands in Phase 2.",
  "type": "module",
  "bin": {
    "suite-sync": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@suite/sync": "workspace:*",
    "@suite/sync-client": "workspace:*",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/ws": "^8.18.2",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
