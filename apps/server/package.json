{
  "name": "@suite/sync-server",
  "version": "0.3.4",
  "private": true,
  "description": "The headless Suite sync server: rooms, WebSocket transport, snapshots, workspace bootstrap and CLI.",
  "type": "module",
  "bin": {
    "suite-sync": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@suite/host": "workspace:*",
    "@suite/sync": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/ws": "^8.18.2",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
